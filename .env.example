# Copy to .env (never commit it) or export in your shell / CI secrets.

# AI for the rewrite engine and the weekly idea generator (Gemini API).
# LLM_API_KEY is a Google AI Studio API key (aistudio.google.com > Get API key).
# The Batch API needs a paid-tier (billing enabled) project.
# Leave LLM_API_KEY empty to build with clearly flagged placeholder descriptions.
LLM_API_KEY=
# The current Gemini 3.8 Flash model id. The pipeline reads the model only
# from this variable; it is not hardcoded anywhere in the code.
LLM_MODEL=gemini-3.8-flash

# Claim form: the form endpoint that emails "Claim this listing" requests to
# you, for example a Formspree form URL (formspree.io > New form). Read when
# the site is built. Without it the claim page says the form is not connected.
CLAIM_FORM_ENDPOINT=

# Optional: Kaggle API credentials (kaggle.com > Settings > API). Without them
# the Kaggle adapter is skipped with one line in the health log.
KAGGLE_USERNAME=
KAGGLE_KEY=
