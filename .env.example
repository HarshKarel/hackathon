# Copy to .env (never commit it) or export in your shell / CI secrets.
# Leave LLM_API_KEY empty to build with clearly flagged placeholder descriptions.
LLM_API_KEY=
LLM_MODEL=

# Optional: Kaggle API credentials (kaggle.com > Settings > API). Without them
# the Kaggle adapter is skipped with one line in the health log.
KAGGLE_USERNAME=
KAGGLE_KEY=
