{
  "name": "hackathon-so",
  "version": "0.1.0",
  "private": true,
  "description": "hackathon.so: a worldwide hackathon directory. Phase 1: data pipeline, rewrite engine, static site.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "pipeline": "node pipeline/run.mjs",
    "pipeline:cached": "node pipeline/run.mjs --use-cache",
    "build": "eleventy",
    "check": "node scripts/check-site.mjs",
    "serve": "eleventy --serve --port 8080",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@anthropic-ai/sdk": "^1.3.0"
  }
}
