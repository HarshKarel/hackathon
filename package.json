{
  "name": "hackathon-so",
  "version": "0.1.0",
  "private": true,
  "description": "hackathon.so: a worldwide hackathon directory with a data pipeline, AI rewrite engine, winners pipeline, idea feed and static site.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "pipeline": "node pipeline/run.mjs",
    "pipeline:cached": "node pipeline/run.mjs --use-cache",
    "build": "eleventy",
    "check": "node scripts/check-site.mjs",
    "serve": "eleventy --serve --port 8080",
    "winners": "node pipeline/winners.mjs",
    "ideas": "node pipeline/ideas.mjs",
    "backfill": "node pipeline/backfill.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:claim": "node scripts/test-claim-form.mjs"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.2"
  }
}
